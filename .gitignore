# ════════════════════════════════════════════════════════════
#  依赖
# ════════════════════════════════════════════════════════════
node_modules/
.agents/node_modules/

# ════════════════════════════════════════════════════════════
#  凭证与配置 —— 最高优先级，绝不进库
#  config.json 含 sessionSecret / 明文 admin 密码 / 平台 accessToken
# ════════════════════════════════════════════════════════════
config.json
config.prod.json
config.demo.json
*.key
*.pem
*.age
.env
.env.*
# 模板文件要进库（反选必须放在忽略规则之后）
!config.demo.example.json
!config.example.json
!backup-recipient.age

# ════════════════════════════════════════════════════════════
#  数据库 —— 237MB，含 23 万客户的姓名与手机号
# ════════════════════════════════════════════════════════════
server/db/*.db
server/db/*.db-wal
server/db/*.db-shm
server/db/*.sqlite
server/db/*.sqlite3
server/db/backups/
# 上面的 server/db/*.db 只匹配 server/db/ 直接下的文件，**不匹配子目录**。
# 而 vacuumSnapshot.js 的快照实际落在 server/db/backup-<时间戳>/trader.db，
# 于是 git status 把整个 218MB 的库列成未跟踪 —— 一次 `git add .` 就进库了。
# 这两条按目录和递归各挡一次，与上面那条的意图（含 23 万客户 PII，绝不进库）一致。
server/db/backup-*/
server/db/**/*.db
sessions.db
sessions.db-wal
sessions.db-shm

# ════════════════════════════════════════════════════════════
#  运行时状态 —— 本地文件、非原子写、每台机器各不相同
# ════════════════════════════════════════════════════════════
sync-state.json
sync-state-*.json
active-company.json
demo-state/
.runtime/
*.pid

# ════════════════════════════════════════════════════════════
#  日志（根目录现有 17 个）—— 无轮转机制，全部由 shell 重定向产生
# ════════════════════════════════════════════════════════════
*.log
logs/

# ════════════════════════════════════════════════════════════
#  备份与导出产物
# ════════════════════════════════════════════════════════════
*.gz
*.zst
*.bz2
*.tar
*.zip
*.bak
*.dump
migrate/

# ════════════════════════════════════════════════════════════
#  临时文件 / 调试脚本 / AI 工作区
#  保留 check-node.js 与 sync.js（后者是 npm run sync 的入口）
# ════════════════════════════════════════════════════════════
_tmp_*
.codex-scratch/
.agents/
*.tmp
*.orig
*.rej
diag-*.js
debug-*.js
patch-*.js
# 员工演练：测试账号密码 + 报告里会抄到真实客户姓名
.scratch/agent-drill/

# 图片：根目录只有调试截图。唯一例外是品牌图标（NXC Report logo / favicon）
*.png
*.jpg
*.jpeg
*.gif
*.webp
!public/brand/*.png
!design-system/brand/*.png

# ════════════════════════════════════════════════════════════
#  编辑器 / 操作系统
# ════════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
